# Copy to .env for local use, and add the same values in
# Vercel > Project > Settings > Environment Variables.

# Password for reading form submissions at /api/admin/submissions/<collection>
ADMIN_KEY=change-me-to-a-long-random-string

# Storage (required on Vercel). Added automatically when you connect
# Upstash Redis from the Vercel Marketplace. Leave empty locally to save to server/data.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: email alerts for every new form submission (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=team@example.org
# Use an address on a domain you've verified in Resend. Without it, Resend's test sender is used.
NOTIFY_FROM=
